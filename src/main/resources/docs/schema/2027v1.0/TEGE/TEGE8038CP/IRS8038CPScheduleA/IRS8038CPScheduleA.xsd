<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns="http://www.irs.gov/efile" xmlns:xsd="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.irs.gov/efile" elementFormDefault="qualified" attributeFormDefault="unqualified" version="1.0">
	
	<xsd:annotation>
		<xsd:documentation>
			<Description>IRS e-file Schema - IRS Form 8038-CP Schedule A</Description>
			<TaxYear>2027</TaxYear>
			<MaturityLevel>Final Schema Version RL10A Drop 1</MaturityLevel>
			<ReleaseDate>May 28 2026</ReleaseDate>
		</xsd:documentation>
	</xsd:annotation>

	<xsd:include schemaLocation="../../../Common/efileTypes.xsd"/>
	<xsd:include schemaLocation="../IRS8038CP/IRS8038CP.xsd"/>

	<!-- ================================================================= -->
	<!-- ================== IRS Form 8038-CP Schedule A ================== -->
	<!-- ================================================================= -->

	<xsd:element name="IRS8038CPScheduleA">
		<xsd:annotation>
			<xsd:documentation>IRS Form 8038-CP Schedule A</xsd:documentation>
		</xsd:annotation>
		<xsd:complexType>
			<xsd:complexContent>
				<xsd:extension base="IRS8038CPScheduleAType">
					<xsd:attributeGroup ref="DocumentAttributes">
						<xsd:annotation>
							<xsd:documentation>Common return document attributes</xsd:documentation>
						</xsd:annotation>
					</xsd:attributeGroup>
					<xsd:attribute name="documentName" type="xsd:string" fixed="IRS8038CPScheduleA">
						<xsd:annotation>
							<xsd:documentation>IRS internal use only. To avoid error in the return, do not include the attribute name or value.</xsd:documentation>
						</xsd:annotation>
					</xsd:attribute>
				</xsd:extension>
			</xsd:complexContent>
		</xsd:complexType>
	</xsd:element>

	<xsd:complexType name="IRS8038CPScheduleAType">
		<xsd:annotation>
			<xsd:documentation>Content model for Form 8038-CP Schedule A</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>

			<!-- Report Number (see instructions) -->
			<xsd:element name="ReportNum">
				<xsd:annotation>
					<xsd:documentation>
						<Description>Report Number (from Form 8038-CP, Line 10)</Description>
						<LineNumber>Top of form</LineNumber>
					</xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="IntegerNNType">
						<xsd:pattern value="[248][0-9][0-9]"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>

			<!-- Eligible interest computation -->
			<xsd:element name="EligibleInterestComputationGrp" maxOccurs="unbounded">
				<xsd:annotation>
					<xsd:documentation>
						<Description>Eligible interest computation</Description>
						<LineNumber>Columns (a) - (e)</LineNumber>
					</xsd:documentation>
				</xsd:annotation>
				<xsd:complexType>
					<xsd:sequence>

						<!-- Bond Maturity Date -->
						<xsd:element name="BondMaturityDt" type="DateType">
							<xsd:annotation>
								<xsd:documentation>
									<Description>Bond Maturity Date</Description>
									<LineNumber>Column (a)</LineNumber>
								</xsd:documentation>
							</xsd:annotation>
						</xsd:element>

						<!-- Interest paid on bond maturity on Line 18 interest payment date -->
						<xsd:element name="IntPdBondMaturityPymtDtAmt" type="USDecimalAmountNN15DgtType">
							<xsd:annotation>
								<xsd:documentation>
									<Description>Interest payable on bond maturity from Form 8038-CP, line 18 interest payment date</Description>
									<LineNumber>Column (b)</LineNumber>
								</xsd:documentation>
							</xsd:annotation>
						</xsd:element>

						<!-- Interest paid on bond maturity on Line 18 interest payment date calculated using the Line 19b applicable credit rate -->
						<xsd:element name="IntPdBondMaturityCalcPymtDtAmt" type="USDecimalAmountNN15DgtType">
							<xsd:annotation>
								<xsd:documentation>
									<Description>Interest payable on bond maturity from Form 8038-CP, line 18 interest payment date calculated using Form 8038-CP, line 19b applicable credit rate</Description>
									<LineNumber>Column (c)</LineNumber>
								</xsd:documentation>
							</xsd:annotation>
						</xsd:element>

						<!-- For new clean renewal energy bonds and qualfied energy conservation bonds, multiply column (c) by 70% (0.70) (Skip this column for qualified zone academy bonds and qualified school construction bonds) -->
						<xsd:element name="IntPdBondMaturityCalc70PctAmt" type="USDecimalAmountNN15DgtType" minOccurs="0">
							<xsd:annotation>
								<xsd:documentation>
									<Description>For NCREBs and QECBs, multiply column (c) by 70% (0.70). (Skip this column for QZABs and QSCBs)</Description>
									<LineNumber>Column (d)</LineNumber>
								</xsd:documentation>
							</xsd:annotation>
						</xsd:element>

						<!-- For new clean renewable energy bonds and qualified energy conservation bonds, enter smaller of column (b) or (d). For qualified zone academy bonds and qualified school construction bonds, enter smaller of column (b) or (c). -->
						<xsd:element name="SmallerInterestPaidOrCalcAmt" type="USDecimalAmountNN15DgtType">
							<xsd:annotation>
								<xsd:documentation>
									<Description>For NCREBs and QECBs, enter smaller of column (b) or (d). For QZABs and QSCBs, enter smaller of column (b) or (c).</Description>
									<LineNumber>Column (e)</LineNumber>
								</xsd:documentation>
							</xsd:annotation>
						</xsd:element>

					</xsd:sequence>
				</xsd:complexType>
			</xsd:element>

			<!-- Total eligible interest payment computed amount -->
			<xsd:element name="TotalEligibleInterestCmptAmt" type="USDecimalAmountNN15DgtType">
				<xsd:annotation>
					<xsd:documentation>
						<Description>Total eligible interest payment computed amount</Description>
						<LineNumber>Line 1</LineNumber>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>

		</xsd:sequence>
	</xsd:complexType>
</xsd:schema>
